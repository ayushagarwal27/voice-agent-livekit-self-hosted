# LiveKit (self-hosted — never LiveKit Cloud)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=4f4a8c66d914a9d6a9d55260110b70397245d90a49621a3fda192fccac7a6784

# Storage
DATABASE_URL=sqlite:///./dev.db

# STT
DEEPGRAM_API_KEY=

# LLM (pick one)
GROQ_API_KEY=
OPENAI_API_KEY=

# TTS (pick one: Cartesia, Deepgram Aura (uses DEEPGRAM_API_KEY), or OpenAI)
CARTESIA_API_KEY=

# Compliance (Phase 9). Optional -- defaults to gpt-4.1-mini if unset.
COMPLIANCE_LLM_MODEL=

# --- Production only (docker-compose.prod.yml) ---
# Domains Traefik routes HTTPS to on the host (see the Deploying section in
# README.md). LIVEKIT_URL/DATABASE_URL above are overridden inside that
# compose file to internal container addresses; these two are not.
BACKEND_DOMAIN=voice.rustler.in
LIVEKIT_DOMAIN=livekit.rustler.in
